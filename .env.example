# ── Turso (production / Vercel) ───────────────────────────────────────────────
# Get these from https://turso.tech after creating a database.
# Leave blank for local development (file-based SQLite is used instead).
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# ── Local development only ────────────────────────────────────────────────────
# Path to the local SQLite file. Ignored when TURSO_DATABASE_URL is set.
DATABASE_PATH=./data/meetups.db

# ── Auth ──────────────────────────────────────────────────────────────────────
# Password for the /admin moderation page. Set to something strong.
ADMIN_PASSWORD=changeme

# Cookie secret used to sign the admin session. Must be 32+ random characters.
SESSION_SECRET=replace-with-32-random-bytes
